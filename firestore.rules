rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Toàn bộ dữ liệu Robot An chỉ đọc/ghi được khi đã đăng nhập Google
    // (khớp với AuthGate chặn truy cập app phía client).
    match /medical_records/{id} {
      allow read, write: if request.auth != null;
    }
    match /status/{id} {
      allow read, write: if request.auth != null;
    }
    match /config/{id} {
      allow read, write: if request.auth != null;
    }
    match /configs/{id} {
      allow read, write: if request.auth != null;
    }
    match /care_schedules/{id} {
      allow read, write: if request.auth != null;
    }
    match /chat_sessions/{id} {
      allow read, write: if request.auth != null;
    }
    match /chat_history/{id} {
      allow read, write: if request.auth != null;
    }
    match /logs/{id} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
